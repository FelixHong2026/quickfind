# Normalise line endings in the repository
* text=auto

# Source and docs: LF
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf

# Windows scripts: CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary
*.exe   binary
*.png   binary
*.jpg   binary
*.ico   binary
